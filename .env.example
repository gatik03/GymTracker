# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
SECURE_SSL_REDIRECT=false
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_DOMAIN=
JWT_ACCESS_COOKIE=gymtracker_access
JWT_REFRESH_COOKIE=gymtracker_refresh
JWT_SESSION_MARKER_COOKIE=gymtracker_session
JWT_ACCESS_COOKIE_MAX_AGE=600
JWT_REFRESH_COOKIE_MAX_AGE=604800
JWT_ACCESS_MINUTES=10
JWT_REFRESH_DAYS=7

# PostgreSQL production configuration
DB_ENGINE=sqlite
DB_NAME=gymtracker
DB_USER=gymtracker
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=require
DB_CONN_MAX_AGE=60

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=GymTracker <no-reply@example.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_VERIFICATION_CODE_HOURS=24
PASSWORD_RESET_CODE_MINUTES=15

# OAuth (required before enabling providers)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
OAUTH_STATE_MAX_AGE=600

# Next.js
NEXT_PUBLIC_API_BASE_URL=/api
BACKEND_API_URL=http://127.0.0.1:8000
